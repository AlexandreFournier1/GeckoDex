<Window x:Class="GeckoDexWPFApp.SecondaryWindows.LoginUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeckoDexWPFApp.SecondaryWindows"
        mc:Ignorable="d"
        Title="GeckoDex Login" Height="320" Width="300" ResizeMode="NoResize" Background="#FFFFF0B3">
    <Grid>
        <!-- CONNEXION -->
        <StackPanel x:Name="LoginPanel" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="200" Width="Auto">
            <TextBlock Text="Login" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#FF5E330A"/>

            <!-- Label et champ Username -->
            <TextBlock Text="Username" Foreground="#FF5E330A" Margin="0,5"/>
            <TextBox x:Name="LoginUsernameBox" Margin="0,5"/>

            <!-- Label et champ Password -->
            <TextBlock Text="Password" Foreground="#FF5E330A" Margin="0,5"/>
            <PasswordBox x:Name="LoginPasswordBox" Margin="0,5"/>

            <Button x:Name="ConfirmLoginButton" Content="Login" Margin="0,10,0,5" Click="LoginButton_Click" Background="#FFD16F1E" BorderBrush="#FF5E330A"/>
            <Button x:Name="RegisterButton" Content="Register" Click="SwitchToRegister_Click" Background="#FFD16F1E" BorderBrush="#FF5E330A"/>
        </StackPanel>

        <!-- ENREGISTREMENT -->
        <StackPanel x:Name="RegisterPanel" VerticalAlignment="Center" Visibility="Collapsed" HorizontalAlignment="Center" MinWidth="200" Width="Auto">
            <TextBlock Text="Register" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="#FF5E330A"/>

            <!-- Label et champ Username -->
            <TextBlock Text="Username" Foreground="#FF5E330A" Margin="0,5"/>
            <TextBox x:Name="RegisterUsernameBox" Margin="0,5"/>

            <!-- Label et champ Password -->
            <TextBlock Text="Password" Foreground="#FF5E330A" Margin="0,5"/>
            <PasswordBox x:Name="RegisterPasswordBox" Margin="0,5"/>

            <!-- Label et champ Confirm Password -->
            <TextBlock Text="Confirm Password" Foreground="#FF5E330A" Margin="0,5"/>
            <PasswordBox x:Name="RegisterConfirmPasswordBox" Margin="0,5"/>

            <Button x:Name="ConfirmRegisterButton" Content="Register" Margin="0,10,0,5" Click="RegisterButton_Click" Background="#FFD16F1E" BorderBrush="#FF5E330A"/>
            <Button x:Name="SwitchToLogin" Content="Back to Login" Click="SwitchToLogin_Click" Background="#FFD16F1E" BorderBrush="#FF5E330A"/>
        </StackPanel>
    </Grid>
</Window>