<Window x:Class="GeckoDexWPFApp.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeckoDexWPFApp"
        mc:Ignorable="d"
        Title="GeckoDex Search"
        Height="500"
        Width="900"
        MinHeight="400"
        MinWidth="600"
        Background="#FFFFF0B3"
        ResizeMode="CanResize">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- Conteneur central -->
        <StackPanel Grid.Column="1"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Margin="10">

            <TextBlock Text="Welcome to GeckoDex!"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       Margin="0,0,0,10"
                       Foreground="#FF5E330A"
                       TextWrapping="Wrap"/>

            <!-- Zone de recherche -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Barre de recherche -->
                <TextBox x:Name="TextSearch"
                         Grid.Column="0"
                         MinWidth="200"
                         Height="30"
                         Background="#FFFFCC80"
                         Foreground="Black"
                         BorderThickness="1"
                         BorderBrush="#FF5E330A"
                         Padding="5,0"
                         VerticalContentAlignment="Center"
                         ToolTip="Find dinosaure"/>

                <!-- Bouton recherche -->
                <Button Grid.Column="1"
                        Height="30"
                        Width="30"
                        Margin="5,0,0,0"
                        Background="#FFD16F1E"
                        BorderBrush="#FF5E330A"
                        ToolTip="Search"
                        Click="SearchButton_Click">
                    <Image Source="Img/SearchButton.png" Stretch="Uniform"/>
                </Button>

                <!-- Catalogue -->
                <Button Grid.Column="2"
                        Height="30"
                        Width="30"
                        Margin="5,0,0,0"
                        Background="#FFD16F1E"
                        BorderBrush="#FF5E330A"
                        ToolTip="Catalogue"
                        Click="Button_Click">
                    <Image Source="/Img/NoteBookButton.png" Stretch="Uniform"/>
                </Button>

                <!-- Recette -->
                <Button Grid.Column="3"
                        Height="30"
                        Width="30"
                        Margin="5,0,0,0"
                        Background="#FFD16F1E"
                        BorderBrush="#FF5E330A"
                        ToolTip="Recette"
                        Click="RecetteButton_Click">
                    <Image Source="/Img/Burger.png" Stretch="Uniform"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Bouton utilisateur -->
        <Button x:Name="UserButton"
                Grid.Column="2"
                Grid.Row="0"
                Width="40"
                Height="40"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="10"
                ToolTip="User"
                Click="UserButton_Click"
                BorderBrush="#FF5E330A"
                Background="Transparent">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="20"/>
                </Style>
            </Button.Resources>
            <Image Source="/Img/User.png" Stretch="UniformToFill"/>
        </Button>
    </Grid>
</Window>