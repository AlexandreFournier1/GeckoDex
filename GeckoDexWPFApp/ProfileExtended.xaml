<Window x:Class="GeckoDexWPFApp.ProfileExtended"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeckoDexWPFApp"
        mc:Ignorable="d"
        Title="ProfileExtended" Height="450" Width="800"
        Background="#FFFFF0B3">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <!-- Profil -->
            <ColumnDefinition Width="*" />
            <!-- Taming en cours -->
        </Grid.ColumnDefinitions>

        <!-- === Profil utilisateur === -->
        <StackPanel Grid.Column="0" Margin="10">
            <Border>
                <Image x:Name="ProfileImage"
                   Source="Img/User.png"
                   Height="150"
                   Width="150"
                   Stretch="UniformToFill"
                   Margin="0,0,0,10"/>
            </Border>
            <Button Content="Changer l'image" Click="ChangeProfileImage_Click"
                Margin="0,10,0,20"
                Background="#FFD16F1E"
                Foreground="White"
                BorderBrush="#FF5E330A"/>

            <TextBlock x:Name="UsernameTextBlock"
                   Text="Nom d'utilisateur"
                   FontWeight="Bold"
                   FontSize="16"
                   Foreground="#FF5E330A"
                   Margin="0,0,0,5"/>
            <TextBlock x:Name="EmailTextBlock"
                   Text="adresse@mail.com"
                   Foreground="#FF5E330A"/>
        </StackPanel>

        <!-- === Taming en cours === -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="Taming en cours"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#FF5E330A"
                   Margin="0,0,0,10"/>
            <TextBlock x:Name="TamingCountTextBlock"
                   Text="Nombre de taming : 0"
                   Foreground="#FF5E330A"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

            <ListBox x:Name="TamingList" ItemsSource="{Binding Tamings}" Margin="10">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="1" BorderBrush="#FF5E330A" Margin="5" Padding="5" Background="White">
                            <StackPanel>
                                <TextBlock Text="{Binding Dinosaure.Name}" FontWeight="Bold" Foreground="#FF5E330A"/>
                                <TextBlock Text="{Binding RemainingTime}" Foreground="Gray"/>
                                <TextBlock Text="{Binding DinoLevel, StringFormat=Niveau : {0}}" />

                                <Button Content="Stop Taming"
                            Margin="0,5,0,0"
                            Background="#FFD16F1E"
                            BorderBrush="#FF5E330A"
                            CommandParameter="{Binding}"
                            Click="StopTaming_Click"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                <Button Content="Importer taming" Width="130" Margin="0,0,10,0"
                    Background="#FFD16F1E" Foreground="White" BorderBrush="#FF5E330A"/>
                <Button Content="Exporter taming" Width="130" Margin="0,0,10,0"
                    Background="#FFD16F1E" Foreground="White" BorderBrush="#FF5E330A"/>
                <Button Content="Stop taming" Width="130" 
                    Background="#FFD16F1E" Foreground="White" BorderBrush="#FF5E330A"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
