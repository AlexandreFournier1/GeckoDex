<Window x:Class="GeckoDexWPFApp.ProfileExtended"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeckoDexWPFApp"
        mc:Ignorable="d"
        Title="ProfileExtended" Height="500" Width="900"
        MinWidth="600" MinHeight="400"
        Background="#FFFFF0B3"
        ResizeMode="CanResize">
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- Profil -->
            <ColumnDefinition Width="*" />   <!-- Taming -->
        </Grid.ColumnDefinitions>

        <!-- === Profil utilisateur === -->
        <StackPanel Grid.Column="0" Margin="10" Width="250" HorizontalAlignment="Left">
            <Border HorizontalAlignment="Center">
                <Image x:Name="ProfileImage"
                       Source="{Binding CurrentUser.ImagePath}"
                       Width="150" Height="150"
                       Stretch="UniformToFill"
                       Margin="0,0,0,10"/>
            </Border>

            <Button Content="Changer l'image"
                    Click="ChangeProfileImage_Click"
                    Margin="0,10,0,20"
                    Background="#FFD16F1E"
                    Foreground="White"
                    BorderBrush="#FF5E330A"/>

            <TextBlock Text="{Binding CurrentUser.Username}"
                       FontWeight="Bold"
                       FontSize="16"
                       Foreground="#FF5E330A"
                       Margin="0,0,0,5"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding CurrentUser.Email}"
                       Foreground="#FF5E330A"
                       TextWrapping="Wrap"/>

            <Button Content="Se déconnecter"
                    Click="Logout_Click"
                    Background="#FFD16F1E"
                    Foreground="White"
                    BorderBrush="#FF5E330A"
                    Margin="0,20,0,0"/>
        </StackPanel>

        <!-- === Taming en cours === -->
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
            <TextBlock Text="Taming en cours"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#FF5E330A"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="TamingCountTextBlock"
                       Foreground="#FF5E330A"
                       FontWeight="Bold"
                       Margin="0,0,0,10"
                       TextWrapping="Wrap"/>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ListBox x:Name="TamingList"
                         ItemsSource="{Binding Tamings}"
                         Margin="0,0,10,0"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1"
                                    BorderBrush="#FF5E330A"
                                    Margin="5" Padding="5"
                                    Background="White">
                                <StackPanel>
                                    <TextBlock Text="{Binding Dinosaure.Name}" FontWeight="Bold" Foreground="#FF5E330A"/>
                                    <TextBlock Text="{Binding FormattedTime}" Foreground="Gray"/>
                                    <TextBlock Text="{Binding DinoLevel, StringFormat=Niveau : {0}}" />

                                    <Button Content="Stop Taming"
                                            Margin="0,5,0,0"
                                            Background="#FFD16F1E"
                                            BorderBrush="#FF5E330A"
                                            CommandParameter="{Binding}"
                                            Click="StopTaming_Click"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>

            <WrapPanel Margin="0,10,0,0" HorizontalAlignment="Left">
                <Button Content="Importer taming"
                        Width="130" Margin="0,0,10,10"
                        Background="#FFD16F1E"
                        Foreground="White"
                        BorderBrush="#FF5E330A"
                        Click="ImportTamings_Click"/>

                <Button Content="Exporter taming"
                        Width="130" Margin="0,0,10,10"
                        Background="#FFD16F1E"
                        Foreground="White"
                        BorderBrush="#FF5E330A"
                        Click="ExportTamings_Click"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>
