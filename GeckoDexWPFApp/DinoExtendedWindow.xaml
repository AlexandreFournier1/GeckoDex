<Window x:Class="GeckoDexWPFApp.DinoExtendedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeckoDexWPFApp"
        mc:Ignorable="d"
        Title="DinoExtendedWindow" Height="450" Width="800"
        Background="#FFFFF0B3">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- Colonne gauche avec image + nom dans une seule bordure -->
        <Border Grid.Column="0" Background="#FFFFCC80" BorderBrush="#FF5E330A" BorderThickness="2" Margin="10">
            <StackPanel>
                <Image Source="{Binding ImagePath}" Margin="10"/>

                <TextBlock Text="{Binding Name}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="#FF5E330A"
                           Padding="10"/>

                <Button Content="TAMING"
                        Background="#FFD16F1E"
                        BorderBrush="#FF5E330A"
                        Margin="10"
                        Padding="5"
                        VerticalAlignment="Center" Click="TamingButton_Click"/>

                <Button Content="BREEDING"
                        Background="#FFD16F1E"
                        BorderBrush="#FF5E330A"
                        Margin="10"
                        Padding="5"
                        VerticalAlignment="Center" Click="BreedingButton_Click"/>
            </StackPanel>
        </Border>
        <!-- Colonne droite avec description-->
        <Border Grid.Column="1" Background="#FFFFD9A6" BorderBrush="#FF5E330A" BorderThickness="2" Margin="10">
            <StackPanel>
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#FF5E330A"
                           Padding="10"
                           TextWrapping="Wrap">
                    <Run Text="Description : "/>
                    <Run Text="{Binding Description}"/>
                </TextBlock>
                
                <TextBlock HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#FF5E330A"
                           Padding="10">
                    <Run Text="Food Supply : "/>
                    <Run Text="{Binding TypeFoodSupply}"/>
                </TextBlock>

                <TextBlock HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="#FF5E330A"
                            Padding="10">
                    <Run Text="Preferred Food : "/>
                    <Run Text="{Binding PreferedFood}"/>
                </TextBlock>

                <TextBlock HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#FF5E330A"
                        Padding="10">
                <Run Text="Prefered Kibble : "/>
                <Run Text="{Binding PreferedKibble.Name}"/>
                </TextBlock>

                <TextBlock HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="#FF5E330A"
                            Padding="10">
                    <Run Text="Type Creature : "/>
                    <Run Text="{Binding TypeCreature}"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
