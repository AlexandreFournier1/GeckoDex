<Window x:Class="GeckoDexWPFApp.DinoExtendedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GeckoDexWPFApp"
        mc:Ignorable="d"
        Title="DinoExtendedWindow" MinHeight="400" MinWidth="600"
        Background="#FFFFF0B3"
        SizeToContent="Manual">

    <!-- Scroll global en cas de trop de contenu -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Colonne gauche -->
            <Border Grid.Column="0" Background="#FFFFCC80" BorderBrush="#FF5E330A" BorderThickness="2" Margin="10">
                <StackPanel VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                    <Image Source="{Binding ImagePath}" Margin="10" Stretch="Uniform" Height="200"/>

                    <TextBlock Text="{Binding Name}"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               Foreground="#FF5E330A"
                               Padding="10" TextWrapping="Wrap"/>

                    <Button Content="TAMING"
                            Background="#FFD16F1E"
                            BorderBrush="#FF5E330A"
                            Margin="10"
                            Padding="5"
                            Click="TamingButton_Click"/>

                    <Button Content="BREEDING"
                            Background="#FFD16F1E"
                            BorderBrush="#FF5E330A"
                            Margin="10"
                            Padding="5"
                            Click="BreedingButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Colonne droite -->
            <Border Grid.Column="1" Background="#FFFFD9A6" BorderBrush="#FF5E330A" BorderThickness="2" Margin="10">
                <StackPanel>
                    <TextBlock FontSize="14" Foreground="#FF5E330A" Padding="10" TextWrapping="Wrap">
                        <Run Text="Description : "/>
                        <Run Text="{Binding Description}"/>
                    </TextBlock>

                    <TextBlock FontSize="14" Foreground="#FF5E330A" Padding="10" TextWrapping="Wrap">
                        <Run Text="Food Supply : "/>
                        <Run Text="{Binding TypeFoodSupply}"/>
                    </TextBlock>

                    <TextBlock FontSize="14" Foreground="#FF5E330A" Padding="10" TextWrapping="Wrap">
                        <Run Text="Preferred Food : "/>
                        <Run Text="{Binding PreferedFood}"/>
                    </TextBlock>

                    <TextBlock FontSize="14" Foreground="#FF5E330A" Padding="10" TextWrapping="Wrap">
                        <Run Text="Prefered Kibble : "/>
                        <Run Text="{Binding PreferedKibble.Name}"/>
                    </TextBlock>

                    <TextBlock FontSize="14" Foreground="#FF5E330A" Padding="10" TextWrapping="Wrap">
                        <Run Text="Type Creature : "/>
                        <Run Text="{Binding TypeCreature}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>